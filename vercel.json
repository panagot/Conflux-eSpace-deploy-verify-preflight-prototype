{
  "version": 2,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build -w @verifyflow/core && npm run build -w @verifyflow/web",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
