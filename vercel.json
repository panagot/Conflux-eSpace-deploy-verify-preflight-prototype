{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
