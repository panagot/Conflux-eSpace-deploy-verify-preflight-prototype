{
  "installCommand": "npm install --prefix .. --include=dev",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "{../core/dist/**,../node_modules/ethers/**}"
    }
  }
}
